`timescale 1ns/1ps

module slave_tb;

    // ====================================================
    // Parameters
    // ====================================================

    parameter ADDR_WIDTH = 12;
    parameter DATA_WIDTH = 8;
    parameter MEM_SIZE   = 4096;
    parameter SPLIT_EN   = 0;

    // Test values
    localparam [ADDR_WIDTH-1:0] TEST_ADDR  = 12'h35A;
    localparam [DATA_WIDTH-1:0] TEST_DATA  = 8'hA5;


    // ====================================================
    // Testbench signals
    // ====================================================

    reg clk;
    reg rstn;

    reg swdata;
    reg smode;
    reg mvalid;

    reg split_grant;

    wire srdata;
    wire svalid;
    wire sready;
    wire ssplit;


    // ====================================================
    // DUT
    // ====================================================

    slave #(
        .ADDR_WIDTH (ADDR_WIDTH),
        .DATA_WIDTH (DATA_WIDTH),
        .SPLIT_EN   (SPLIT_EN),
        .MEM_SIZE   (MEM_SIZE)
    ) uut (
        .clk         (clk),
        .rstn        (rstn),

        .swdata      (swdata),
        .srdata      (srdata),

        .smode       (smode),
        .mvalid      (mvalid),

        .split_grant (split_grant),

        .svalid      (svalid),
        .sready      (sready),
        .ssplit      (ssplit)
    );


    // ====================================================
    // Clock generation
    //
    // 10 ns period = 100 MHz
    // ====================================================

    initial begin
        clk = 1'b0;

        forever #5 clk = ~clk;
    end


    // ====================================================
    // Send address serially
    //
    // slave_port expects LSB first
    // ====================================================

    task send_address;

        input [ADDR_WIDTH-1:0] address;

        integer i;

        begin

            for (i = 0; i < ADDR_WIDTH; i = i + 1) begin

                @(negedge clk);

                swdata = address[i];
                mvalid = 1'b1;

                @(posedge clk);
                #1;

            end

        end

    endtask


    // ====================================================
    // Send write data serially
    //
    // LSB first
    // ====================================================

    task send_write_data;

        input [DATA_WIDTH-1:0] data;

        integer i;

        begin

            for (i = 0; i < DATA_WIDTH; i = i + 1) begin

                @(negedge clk);

                swdata = data[i];
                mvalid = 1'b1;

                @(posedge clk);
                #1;

            end

        end

    endtask


    // ====================================================
    // Receive read data serially
    // ====================================================

    task receive_read_data;

        output [DATA_WIDTH-1:0] data;

        integer i;

        begin

            data = {DATA_WIDTH{1'b0}};

            // Wait until slave begins transmitting
            wait (svalid == 1'b1);

            for (i = 0; i < DATA_WIDTH; i = i + 1) begin

                @(negedge clk);

                if (svalid)
                    data[i] = srdata;
                else
                    $display(
                        "ERROR: svalid became low at bit %0d",
                        i
                    );

            end

        end

    endtask


    // ====================================================
    // Variable for received read data
    // ====================================================

    reg [DATA_WIDTH-1:0] received_data;


    // ====================================================
    // Main test
    // ====================================================

    initial begin

        // ------------------------------------------------
        // Initial values
        // ------------------------------------------------

        rstn        = 1'b0;
        swdata      = 1'b0;
        smode       = 1'b0;
        mvalid      = 1'b0;
        split_grant = 1'b0;

        received_data = {DATA_WIDTH{1'b0}};


        // ------------------------------------------------
        // Reset
        // ------------------------------------------------

        $display("");
        $display("================================");
        $display("RESET TEST");
        $display("================================");

        #12;
        rstn = 1'b1;

        @(posedge clk);
        #1;

        if (sready == 1'b1)
            $display("PASS: Slave is ready after reset");
        else
            $display("ERROR: Slave not ready after reset");


        // =================================================
        // TEST 1: WRITE
        // =================================================

        $display("");
        $display("================================");
        $display("WRITE TEST");
        $display("Address = 0x%h", TEST_ADDR);
        $display("Data    = 0x%h", TEST_DATA);
        $display("================================");


        // Wait until slave is ready
        wait (sready == 1'b1);

        // Select WRITE operation
        smode = 1'b1;

        // Send address
        send_address(TEST_ADDR);

        // Send data
        send_write_data(TEST_DATA);


        // Stop transmitting
        @(negedge clk);

        mvalid = 1'b0;
        swdata = 1'b0;


        // Wait until write transaction finishes
        wait (sready == 1'b1);

        $display("PASS: Write transaction completed");


        // =================================================
        // TEST 2: READ SAME ADDRESS
        // =================================================

        $display("");
        $display("================================");
        $display("READ TEST");
        $display("Address = 0x%h", TEST_ADDR);
        $display("Expected Data = 0x%h", TEST_DATA);
        $display("================================");


        // Select READ operation
        smode = 1'b0;

        // Send same address
        send_address(TEST_ADDR);


        // Master has finished sending address
        @(negedge clk);

        mvalid = 1'b0;
        swdata = 1'b0;


        // Receive serial read data
        receive_read_data(received_data);


        // ------------------------------------------------
        // Verify result
        // ------------------------------------------------

        if (received_data == TEST_DATA) begin

            $display(
                "PASS: Read data = 0x%h",
                received_data
            );

        end
        else begin

            $display(
                "ERROR: Expected 0x%h but received 0x%h",
                TEST_DATA,
                received_data
            );

        end


        // Wait until slave becomes ready again
        wait (sready == 1'b1);


        // =================================================
        // Split check
        // =================================================

        if (ssplit == 1'b0)
            $display("PASS: Split remains disabled");
        else
            $display("ERROR: Unexpected split");


        // =================================================
        // End simulation
        // =================================================

        #20;

        $display("");
        $display("================================");
        $display("SLAVE TEST COMPLETED");
        $display("================================");

        $finish;

    end


    // ====================================================
    // Monitor
    // ====================================================

    initial begin

        $monitor(
            "T=%0t rstn=%b smode=%b mvalid=%b swdata=%b srdata=%b svalid=%b sready=%b ssplit=%b",
            $time,
            rstn,
            smode,
            mvalid,
            swdata,
            srdata,
            svalid,
            sready,
            ssplit
        );

    end

endmodule
