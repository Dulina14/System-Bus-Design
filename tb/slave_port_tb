`timescale 1ns/1ps

module slave_port_tb;

    // ====================================================
    // Parameters
    // ====================================================

    localparam ADDR_WIDTH = 12;
    localparam DATA_WIDTH = 8;
    localparam SPLIT_EN   = 0;

    // Test values
    localparam [ADDR_WIDTH-1:0] TEST_ADDR  = 12'h35A;
    localparam [DATA_WIDTH-1:0] WRITE_DATA = 8'hA5;
    localparam [DATA_WIDTH-1:0] READ_DATA  = 8'hCC;


    // ====================================================
    // DUT inputs
    // ====================================================

    reg clk;
    reg rstn;

    // Memory-side inputs
    reg [DATA_WIDTH-1:0] smemrdata;
    reg                  rvalid;

    // Serial-bus inputs
    reg swdata;
    reg smode;
    reg mvalid;

    reg split_grant;


    // ====================================================
    // DUT outputs
    // ====================================================

    // Memory-side outputs
    wire                  smemwen;
    wire                  smemren;
    wire [ADDR_WIDTH-1:0] smemaddr;
    wire [DATA_WIDTH-1:0] smemwdata;

    // Serial-bus outputs
    wire srdata;
    wire svalid;
    wire sready;
    wire ssplit;


    // ====================================================
    // DUT
    // ====================================================

    slave_port #(
        .ADDR_WIDTH (ADDR_WIDTH),
        .DATA_WIDTH (DATA_WIDTH),
        .SPLIT_EN   (SPLIT_EN)
    ) dut (
        .clk         (clk),
        .rstn        (rstn),

        // Memory interface
        .smemrdata   (smemrdata),
        .rvalid      (rvalid),
        .smemwen     (smemwen),
        .smemren     (smemren),
        .smemaddr    (smemaddr),
        .smemwdata   (smemwdata),

        // Serial bus interface
        .swdata      (swdata),
        .srdata      (srdata),
        .smode       (smode),
        .mvalid      (mvalid),

        // Split support
        .split_grant (split_grant),
        .svalid      (svalid),
        .sready      (sready),
        .ssplit      (ssplit)
    );


    // ====================================================
    // Clock generation
    //
    // Period = 10 ns
    // ====================================================

    always #5 clk = ~clk;


    // ====================================================
    // Task: Send address serially
    //
    // slave_port receives LSB first:
    // address[0], address[1], ...
    // ====================================================

    task send_address;
        input [ADDR_WIDTH-1:0] address;
        integer i;
        begin

            for (i = 0; i < ADDR_WIDTH; i = i + 1) begin

                // Change inputs away from positive edge
                @(negedge clk);

                mvalid = 1'b1;
                swdata = address[i];

                // DUT captures bit here
                @(posedge clk);
                #1;
            end
        end
    endtask


    // ====================================================
    // Task: Send write data serially
    //
    // Again LSB first.
    // ====================================================

    task send_write_data;
        input [DATA_WIDTH-1:0] data;
        integer i;
        begin

            for (i = 0; i < DATA_WIDTH; i = i + 1) begin

                @(negedge clk);

                mvalid = 1'b1;
                swdata = data[i];

                @(posedge clk);
                #1;
            end
        end
    endtask


    // ====================================================
    // Task: Receive serial read data
    // ====================================================

    task receive_read_data;
        output [DATA_WIDTH-1:0] data;
        integer i;
        begin

            data = {DATA_WIDTH{1'b0}};

            // Wait until slave starts transmitting
            wait (svalid == 1'b1);

            for (i = 0; i < DATA_WIDTH; i = i + 1) begin

                // srdata is stable between positive edges
                @(negedge clk);

                if (svalid)
                    data[i] = srdata;
                else
                    $display(
                        "ERROR: svalid became low during read at bit %0d",
                        i
                    );

            end
        end
    endtask


    // ====================================================
    // Test variables
    // ====================================================

    reg [DATA_WIDTH-1:0] received_data;


    // ====================================================
    // Main test sequence
    // ====================================================

    initial begin

        // ------------------------------------------------
        // Initial values
        // ------------------------------------------------

        clk         = 1'b0;
        rstn        = 1'b1;

        smemrdata   = {DATA_WIDTH{1'b0}};
        rvalid      = 1'b0;

        swdata      = 1'b0;
        smode       = 1'b0;
        mvalid      = 1'b0;

        split_grant = 1'b0;

        received_data = {DATA_WIDTH{1'b0}};


        // =================================================
        // TEST 1: ASYNCHRONOUS RESET
        // =================================================

        $display("");
        $display("========================================");
        $display("TEST 1: Asynchronous reset");
        $display("========================================");

        // Assert reset BETWEEN clock edges
        #2;
        rstn = 1'b0;

        // Should reset immediately
        #1;

        if (sready !== 1'b1)
            $display("ERROR: Slave not ready after reset");
        else
            $display("PASS: Slave returned to IDLE asynchronously");

        if (svalid !== 1'b0)
            $display("ERROR: svalid should be 0 after reset");

        if (smemwen !== 1'b0)
            $display("ERROR: smemwen should be 0 after reset");

        if (smemren !== 1'b0)
            $display("ERROR: smemren should be 0 after reset");

        if (ssplit !== 1'b0)
            $display("ERROR: ssplit should be 0 after reset");


        // Release reset
        #4;
        rstn = 1'b1;

        @(posedge clk);
        #1;


        // =================================================
        // TEST 2: WRITE TRANSACTION
        // =================================================

        $display("");
        $display("========================================");
        $display("TEST 2: Write transaction");
        $display("Address = 0x%h", TEST_ADDR);
        $display("Data    = 0x%h", WRITE_DATA);
        $display("========================================");

        // Wait until slave says it is ready
        wait (sready == 1'b1);

        smode = 1'b1;        // WRITE

        // Send address
        send_address(TEST_ADDR);

        // Send write data
        send_write_data(WRITE_DATA);

        // Master finished transmitting
        @(negedge clk);
        mvalid = 1'b0;
        swdata = 1'b0;


        // Wait for memory write request
        wait (smemwen == 1'b1);
        #1;

        // Check reconstructed address
        if (smemaddr !== TEST_ADDR) begin
            $display(
                "ERROR: Write address incorrect. Expected=%h Got=%h",
                TEST_ADDR,
                smemaddr
            );
        end
        else begin
            $display(
                "PASS: Write address correctly reconstructed = %h",
                smemaddr
            );
        end


        // Check reconstructed data
        if (smemwdata !== WRITE_DATA) begin
            $display(
                "ERROR: Write data incorrect. Expected=%h Got=%h",
                WRITE_DATA,
                smemwdata
            );
        end
        else begin
            $display(
                "PASS: Write data correctly reconstructed = %h",
                smemwdata
            );
        end


        // Wait for transaction to finish
        wait (sready == 1'b1);


        // =================================================
        // TEST 3: READ TRANSACTION
        // =================================================

        $display("");
        $display("========================================");
        $display("TEST 3: Read transaction");
        $display("Address = 0x%h", TEST_ADDR);
        $display("Memory returns = 0x%h", READ_DATA);
        $display("========================================");


        smode = 1'b0;        // READ

        // Send address
        send_address(TEST_ADDR);

        @(negedge clk);
        mvalid = 1'b0;
        swdata = 1'b0;


        // Wait until slave requests memory read
        wait (smemren == 1'b1);

        $display(
            "Slave requested memory read at address %h",
            smemaddr
        );


        // Check read address
        if (smemaddr !== TEST_ADDR) begin
            $display(
                "ERROR: Read address incorrect. Expected=%h Got=%h",
                TEST_ADDR,
                smemaddr
            );
        end


        // ------------------------------------------------
        // Simulate synchronous memory response
        //
        // Allow slave to move:
        // SREADY -> RVALID
        // ------------------------------------------------

        @(posedge clk);
        #1;

        // Memory returns data
        @(negedge clk);

        smemrdata = READ_DATA;
        rvalid    = 1'b1;


        // slave_port captures rdata here
        @(posedge clk);
        #1;


        // rvalid only needs to pulse
        @(negedge clk);

        rvalid = 1'b0;


        // ------------------------------------------------
        // Receive serialized read data
        // ------------------------------------------------

        receive_read_data(received_data);


        // Check returned data
        if (received_data !== READ_DATA) begin

            $display(
                "ERROR: Read data incorrect. Expected=%h Received=%h",
                READ_DATA,
                received_data
            );

        end
        else begin

            $display(
                "PASS: Read data correctly serialized = %h",
                received_data
            );

        end


        // Wait until slave becomes ready again
        wait (sready == 1'b1);


        // =================================================
        // TEST 4: Verify split disabled
        // =================================================

        $display("");
        $display("========================================");
        $display("TEST 4: Split disabled");
        $display("========================================");

        if (ssplit !== 1'b0)
            $display("ERROR: ssplit asserted when SPLIT_EN=0");
        else
            $display("PASS: No split generated for normal slave");


        // =================================================
        // End simulation
        // =================================================

        #20;

        $display("");
        $display("========================================");
        $display("ALL NORMAL SLAVE TESTS COMPLETED");
        $display("========================================");

        $finish;

    end


    // ====================================================
    // Optional waveform monitor
    // ====================================================

    initial begin
    $monitor(
        "T=%0t rstn=%b state=%b mvalid=%b swdata=%b smode=%b smemren=%b smemwen=%b svalid=%b srdata=%b sready=%b ssplit=%b",
        $time,
        rstn,
        dut.state,
        mvalid,
        swdata,
        smode,
        smemren,
        smemwen,
        svalid,
        srdata,
        sready,
        ssplit
    );
end

endmodule
