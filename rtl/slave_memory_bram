module slave_memory_bram #(
    parameter ADDR_WIDTH = 12,
    parameter DATA_WIDTH = 8,
    parameter MEM_SIZE   = 4096
)(
    input  wire                  clk,
    input  wire                  rstn,

    input  wire                  wen,
    input  wire                  ren,

    input  wire [ADDR_WIDTH-1:0] addr,
    input  wire [DATA_WIDTH-1:0] wdata,

    output wire [DATA_WIDTH-1:0] rdata,
    output reg                   rvalid
);

    // ====================================================
    // Memory organization
    // ====================================================

    localparam BYTES_PER_WORD = DATA_WIDTH / 8;
    localparam NUM_LOCATIONS  = MEM_SIZE / BYTES_PER_WORD;
    localparam MEM_ADDR_WIDTH = $clog2(NUM_LOCATIONS);

    // ====================================================
    // BRAM selection
    // ====================================================

    generate

        if (MEM_SIZE == 4096) begin : GEN_BRAM_4K

            slave_bram memory_inst (
                .address (addr[MEM_ADDR_WIDTH-1:0]),
                .clock   (clk),
                .data    (wdata),
                .rden    (ren),
                .wren    (wen),
                .q       (rdata)
            );

        end
        else if (MEM_SIZE == 2048) begin : GEN_BRAM_2K

            slave_bram_2k memory_inst (
                .address (addr[MEM_ADDR_WIDTH-1:0]),
                .clock   (clk),
                .data    (wdata),
                .rden    (ren),
                .wren    (wen),
                .q       (rdata)
            );

        end

    endgenerate

    // ====================================================
    // Read-valid control
    //
    // Assumes BRAM read data becomes valid one clock
    // after ren is asserted.
    // ====================================================

    always @(posedge clk or negedge rstn) begin
        if (!rstn)
            rvalid <= 1'b0;
        else
            rvalid <= ren;
    end

endmodule
